{
  "openapi": "3.0.3",
  "info": {
    "title": "Zz Rich toy",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://api.example.com"
    }
  ],
  "tags": [
    {
      "name": "ZzRich/Items"
    },
    {
      "name": "ZzRich/Owners"
    }
  ],
  "paths": {
    "/zz-rich/v1/items": {
      "get": {
        "tags": [
          "ZzRich/Items"
        ],
        "summary": "List items",
        "operationId": "zzListItems",
        "security": [
          {
            "apiKey": []
          }
        ],
        "description": "Returns a page of items.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Restrict to these statuses. Repeatable.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ACTIVE",
                  "RETIRED"
                ]
              }
            },
            "explode": true
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum items per page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, from 1.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of items",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemPage"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "ERR",
                  "message": "Bad request"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "ERR",
                  "message": "Unauthorized"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "ERR",
                  "message": "Unprocessable"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "ZzRich/Items"
        ],
        "summary": "Create item",
        "operationId": "zzCreateItem",
        "security": [
          {
            "apiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemInput"
              },
              "example": {
                "name": "Alpha",
                "status": "ACTIVE"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Location": {
                "description": "URL of the new item",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "ERR",
                  "message": "Bad request"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "ERR",
                  "message": "Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/zz-rich/v1/items/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Item id.",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "tags": [
          "ZzRich/Items"
        ],
        "summary": "Get item",
        "operationId": "zzGetItem",
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "The item",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "ERR",
                  "message": "Unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "ERR",
                  "message": "Not found"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "ZzRich/Items"
        ],
        "summary": "Edit item",
        "operationId": "zzEditItem",
        "security": [
          {
            "apiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "ERR",
                  "message": "Bad request"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "ERR",
                  "message": "Not found"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "ZzRich/Items"
        ],
        "summary": "Delete item",
        "operationId": "zzDeleteItem",
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "ERR",
                  "message": "Not found"
                }
              }
            }
          }
        }
      }
    },
    "/zz-rich/v1/owners": {
      "get": {
        "tags": [
          "ZzRich/Owners"
        ],
        "summary": "List owners",
        "operationId": "zzListOwners",
        "security": [
          {
            "oauth2": [
              "read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Owners",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Owner"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "ERR",
                  "message": "Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/zz-rich/v1/owners/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Owner id.",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "tags": [
          "ZzRich/Owners"
        ],
        "summary": "Get owner",
        "operationId": "zzGetOwner",
        "security": [
          {
            "oauth2": [
              "read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "The owner",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Owner"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "headers": {
              "X-Correlation-Id": {
                "description": "Correlation ID for tracing",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "ERR",
                  "message": "Not found"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Meta": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          }
        }
      },
      "Owner": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ItemInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "RETIRED"
            ]
          }
        }
      },
      "Item": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ItemInput"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "owner": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Owner"
                  }
                ],
                "nullable": true
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "score": {
                "type": "number",
                "nullable": true,
                "example": 12.5
              }
            }
          }
        ]
      },
      "ItemPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "API-KEY"
      },
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.example.com/token",
            "scopes": {
              "read": "Read access"
            }
          }
        }
      }
    }
  }
}